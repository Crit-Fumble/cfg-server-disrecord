{
  "name": "@crit-fumble/server-disrecord",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Crit-Fumble DisRecord \u2014 self-contained Discord voice recording container. Boots its own bot, captures voice, mixes mp3, and transcribes. Runs local-only or CFG-hosted (phones home to cfg-core-server for billing/object-storage/consent).",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crit-Fumble/cfg-server-disrecord.git"
  },
  "homepage": "https://github.com/Crit-Fumble/cfg-server-disrecord",
  "main": "./dist/index.js",
  "bin": {
    "disrecord": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env --clear-screen=false src/index.ts serve",
    "build": "tsc && tsc-alias -f",
    "start": "node dist/index.js serve",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "tune:deepgram": "tsx --env-file=.env tools/deepgram-tuning/replay.ts",
    "clean": "rimraf dist",
    "test": "jest --config jest.config.cjs",
    "test:unit": "jest --config jest.config.cjs --testPathPatterns=tests/unit",
    "test:integration": "jest --config jest.config.cjs --testPathPatterns=tests/integration",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/lib-storage": "^3.1111.0",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "fastify": "^5.12.0",
    "jose": "^6.2.9",
    "libsodium-wrappers": "^0.8.4",
    "pino": "^10.1.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.5.13",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "rimraf": "^6.1.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "tar": "^7.5.16",
    "undici": "^6.28.0",
    "ws": "$ws",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.2.0"
    }
  }
}
