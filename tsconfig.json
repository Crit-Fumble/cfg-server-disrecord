{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // TS 7 REMOVED `baseUrl` (TS5102) and rejects non-relative path targets
    // (TS5090). Without baseUrl, `paths` resolve relative to this file, so the
    // leading `./` is what replaces it — same mapping, no behaviour change.
    // ⚠️ tsc-alias reads these to rewrite `@/` in the emitted JS; the build
    // checks dist for surviving `@/` imports, because a silently un-rewritten
    // alias fails at runtime, not at compile time.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
